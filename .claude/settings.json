{
  "outputStyle": "Terse",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)", "Bash(uv run ruff:*)", "Bash(uv run mypy:*)",
      "Bash(uv run syscards:*)", "Bash(uv sync:*)",
      "Bash(git push:*)", "Bash(git fetch:*)", "Bash(git branch:*)", "Bash(git status:*)",
      "Bash(git log:*)", "Bash(git diff:*)", "Bash(git merge-base:*)", "Bash(git symbolic-ref:*)",
      "Bash(gh pr list:*)", "Bash(python3 -c:*)"
    ]
  },
  "enabledMcpjsonServers": ["github", "playwright"],
  "hooks": {
    "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/anti-guess-reminder.sh"}]}],
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/branch-base-guard.py", "timeout": 30}]}],
    "PostToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/branch-base-record.py", "timeout": 30}]}],
    "SessionStart": [{"matcher": "", "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/branch-staleness-notice.sh", "timeout": 30}]}]
  }
}